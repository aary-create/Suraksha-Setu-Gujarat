# Optional. Without it, user profiles don't persist between server
# restarts (they still work within a session). Location search, hospitals
# and the map need no key at all — they run on free, keyless OpenStreetMap
# services (Nominatim + Overpass), not Google.
DATABASE_URL=

# Optional. Without either of these, "Explain this alert simply" still
# works via the built-in offline glossary — these just add a one-time AI
# rewrite of the alert's own headline, cached on-device for 5 days after
# the first call. GROQ_API_KEY is free (no credit card, sign up at
# console.groq.com) and is used by default if set. ANTHROPIC_API_KEY is a
# paid, higher-quality opt-in — used only if GROQ_API_KEY isn't set.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Enables Web Push, so a severe or extreme alert reaches a phone
# that isn't currently showing the app — polling alone only warns someone
# who is already looking. Generate a pair with:
#   npx web-push generate-vapid-keys
# Needs DATABASE_URL as well, since subscriptions have to be stored.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.org

# Optional. If set, /api/cron/check-alerts refuses any request without a
# matching "Authorization: Bearer <secret>" header. Vercel Cron sends this
# automatically when the variable is present.
CRON_SECRET=
